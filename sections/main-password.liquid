{% comment %}
  Password page shown while the store is password protected.
{% endcomment %}

<div class="section page-width page-width--narrow stack">
  <p class="eyebrow text-muted">{{ shop.name }}</p>
  <h1>{{ 'password.title' | t }}</h1>

  {%- if shop.password_message != blank -%}
    <p class="lead text-muted">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'storefront_password', class: 'stack' -%}
    {%- if form.errors -%}
      <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <div class="field">
      <label for="PasswordInput">{{ 'password.password' | t }}</label>
      <input
        type="password"
        name="password"
        id="PasswordInput"
        autocomplete="current-password"
        {% if form.errors %}
          aria-invalid="true"
        {% endif %}
      >
    </div>

    <p><button type="submit" class="button">{{ 'password.enter' | t }}</button></p>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": []
}
{% endschema %}
