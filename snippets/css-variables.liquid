{% doc %}
  Outputs the theme's design tokens as CSS custom properties: font faces,
  typography, spacing, radius, motion and one class per color scheme.
  The first color scheme is also applied to :root as the page default.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{%- liquid
  assign body_font = settings.type_body_font
  assign body_font_semibold = body_font | font_modify: 'weight', '600'
  assign heading_font = settings.type_heading_font

  case settings.button_radius
    when 'square'
      assign button_radius = '0px'
    when 'rounded'
      assign button_radius = '8px'
    else
      assign button_radius = '999px'
  endcase

  if settings.section_spacing == 'compact'
    assign section_spacing = 'clamp(2.5rem, 1.5rem + 4vw, 5rem)'
  else
    assign section_spacing = 'clamp(3.5rem, 2rem + 6vw, 7.5rem)'
  endif
-%}

{% style %}
  {% # Only the weights that are actually used: body 400 + 600, headings in the selected weight %}
  {{ body_font | font_face: font_display: 'swap' }}
  {%- if body_font_semibold %}
    {{ body_font_semibold | font_face: font_display: 'swap' }}
  {%- endif %}
  {{ heading_font | font_face: font_display: 'swap' }}

  :root {
    /* Typography */
    --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-weight-bold: {% if body_font_semibold %}600{% else %}bold{% endif %};
    --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading-weight: {{ heading_font.weight }};
    --font-heading-case: {{ settings.type_heading_case }};

    --fs-display: clamp(2.25rem, 1.6rem + 3.4vw, 5rem);
    --fs-h1: clamp(2rem, 1.6rem + 2vw, 3.5rem);
    --fs-h2: clamp(1.75rem, 1.4rem + 1.5vw, 2.75rem);
    --fs-h3: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
    --fs-h4: 1.0625rem;
    --fs-lead: clamp(1.125rem, 1.05rem + 0.4vw, 1.3125rem);
    --fs-body: 1rem;
    --fs-small: 0.875rem;

    --lh-tight: 1.1;
    --lh-heading: 1.2;
    --lh-body: 1.6;
    --measure: 65ch;

    /* Spacing (4px grid) */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.5rem;
    --space-6: 2rem;
    --space-7: 3rem;
    --space-8: 4rem;
    --space-9: 6rem;
    --space-10: 8rem;

    /* Layout */
    --page-width: {{ settings.page_width }};
    --page-width-wide: 90rem;
    --gutter: clamp(1rem, 0.5rem + 2.5vw, 2.5rem);
    --gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
    --section-y: {{ section_spacing }};
    --header-height: 4rem;

    /* Shape */
    --radius-s: 6px;
    --radius-m: 12px;
    --radius-l: 20px;
    --radius-button: {{ button_radius }};
    --border-width: 1px;
    --touch-target: 48px;

    /* Elevation */
    --shadow-overlay: 0 8px 32px rgb(11 15 20 / 0.12);

    /* Product stage: dark backdrop for product images in every color scheme
       (matches the night scheme defaults, see docs/design-reference/design-language.md) */
    --color-stage: #0B0F14;
    --color-stage-edge: #2A3441;
    --color-stage-text: #F2F4F7;
    --color-stage-glow: #3DD5EE;
  }

  /* Backdrop dim + motion tokens. Also set on ::backdrop itself, which does not
     inherit custom properties from :root in every supported browser. */
  :root,
  ::backdrop {
    --color-backdrop: rgb(11 15 20 / 0.55);

    /* Motion */
    --ease-out: cubic-bezier(0.2, 0.7, 0.2, 1);
    --duration-fast: 150ms;
    --duration-base: 250ms;
    --duration-slow: 600ms;
  }

  {% for scheme in settings.color_schemes -%}
    {%- liquid
      assign s = scheme.settings
      assign brightness = s.background | color_brightness
      if forloop.first
        assign selector = ':root, .color-' | append: scheme.id
      else
        assign selector = '.color-' | append: scheme.id
      endif
    -%}
    {{ selector }} {
      --color-bg: {{ s.background }};
      --gradient-bg: {{ s.background_gradient | default: 'none' }};
      --color-surface: {{ s.surface }};
      --color-text: {{ s.text }};
      --color-text-muted: {{ s.text_muted }};
      --color-accent: {{ s.accent }};
      --color-button: {{ s.button }};
      --color-button-label: {{ s.button_label }};
      --color-border: {{ s.border }};
      --color-border-strong: {{ s.border_strong }};
      --color-sale: {{ s.sale }};
      --color-success: {{ s.success }};
      color-scheme: {% if brightness < 128 %}dark{% else %}light{% endif %};
    }
  {% endfor %}
{% endstyle %}
