<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Charset, viewport, title, description, canonical, social tags – must come first %}
    {% render 'meta-tags' %}

    {%- if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif %}

    {% comment %}
      Font loading: fonts are served from the shop's own domain (/cdn/fonts),
      so no preconnect is needed. Preload only the two faces needed for the
      first paint (body regular + heading). The body semibold face loads on
      demand via @font-face with display: swap.
    {% endcomment %}
    {%- unless settings.type_body_font.system? %}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless %}
    {%- unless settings.type_heading_font.system? %}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless %}

    {% # Design tokens, then the critical CSS for every page %}
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% comment %}
      JavaScript: component scripts use {% javascript %} in their section or
      snippet and are bundled and loaded deferred by Shopify. Global scripts
      are added here with defer – never render-blocking in <head>.
    {% endcomment %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}{% if settings.animations_enabled %} animations-enabled{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
