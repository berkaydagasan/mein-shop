{% doc %}
  Renders a product price according to German price display rules. All
  values come from ONE variant so they always belong together:
  - the passed variant, otherwise the cheapest variant ("ab" price when
    variant prices differ)
  - sale price with that variant's struck-through compare-at price
    (screen-reader labelled)
  - that variant's unit price (Grundpreis, PAngV) when set
  - an optional tax/shipping note

  Note: only use compare-at prices that comply with § 11 PAngV
  (lowest price of the last 30 days).

  @param {product} product - The product
  @param {variant} [variant] - Variant to show; defaults to the cheapest variant
  @param {boolean} [show_tax_note] - Show "inkl. MwSt., zzgl. Versand" below the price
  @param {string} [class] - Additional classes

  @example
  {% render 'price', product: product, show_tax_note: true %}
{% enddoc %}

{%- liquid
  assign price_variant = variant
  if price_variant == blank
    assign price_variant = product.selected_or_first_available_variant
    if product.price_varies
      for candidate in product.variants
        if candidate.price == product.price
          assign price_variant = candidate
          break
        endif
      endfor
    endif
  endif

  assign on_sale = false
  if price_variant.compare_at_price > price_variant.price
    assign on_sale = true
  endif

  assign price = price_variant.price | money
  if product.price_varies and variant == blank
    assign price = 'products.price_from' | t: price: price
  endif
-%}

<div class="price{% if on_sale %} price--sale{% endif %}{% if class != blank %} {{ class }}{% endif %}">
  <p class="price__line">
    {%- if on_sale -%}
      <span class="visually-hidden">{{ 'products.sale_price' | t }}</span>
      <span class="price__current">{{ price }}</span>
      <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
      <s class="price__compare">{{ price_variant.compare_at_price | money }}</s>
    {%- else -%}
      <span class="price__current">{{ price }}</span>
    {%- endif -%}
  </p>

  {%- if price_variant.unit_price_measurement -%}
    <p class="price__unit">
      <span class="visually-hidden">{{ 'products.unit_price' | t }}</span>
      {{ price_variant.unit_price | money }}
      /
      {%- if price_variant.unit_price_measurement.reference_value != 1 -%}
        {{ price_variant.unit_price_measurement.reference_value }}
      {%- endif %}
      {{ price_variant.unit_price_measurement.reference_unit }}
    </p>
  {%- endif -%}

  {%- if show_tax_note -%}
    <p class="price__note">{{ 'products.tax_note' | t }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .price {
    display: grid;
    gap: var(--space-1);
  }

  .price__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    font-weight: var(--font-body-weight-bold);
  }

  .price--sale .price__current {
    color: var(--color-sale);
  }

  .price__compare {
    color: var(--color-text-muted);
    font-weight: var(--font-body-weight);
  }

  .price__unit,
  .price__note {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    line-height: 1.4;
  }
{% endstylesheet %}
