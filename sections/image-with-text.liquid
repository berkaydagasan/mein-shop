{% comment %}
  Image with text (Story): image left or right, eyebrow, heading, rich
  text and an optional button. Stacks on mobile with the image first.
{% endcomment %}

{%- assign heading_id = 'Heading-' | append: section.id -%}

<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="image-with-text image-with-text--{{ section.settings.image_position }}">
      <div class="image-with-text__media reveal">
        {% render 'image',
          image: section.settings.image,
          ratio: section.settings.image_ratio,
          sizes: '(min-width: 750px) 50vw, 100vw',
          max_width: 1600,
          widths: '375, 550, 750, 1000, 1300, 1600',
          placeholder: 'lifestyle-1'
        %}
      </div>

      <div class="image-with-text__content stack" style="--stack-space: var(--space-4);" role="region" aria-labelledby="{{ heading_id }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow image-with-text__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 id="{{ heading_id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte text-muted">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <p class="image-with-text__button">
            <a class="button button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .image-with-text__eyebrow {
    color: var(--color-accent);
  }

  .image-with-text__button {
    padding-top: var(--space-2);
  }

  @media (min-width: 750px) {
    .image-with-text {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
    }

    .image-with-text--right .image-with-text__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:common.image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:common.image_ratio",
      "options": [
        { "value": "4 / 5", "label": "t:common.ratio_portrait" },
        { "value": "1 / 1", "label": "t:common.ratio_square" },
        { "value": "3 / 2", "label": "t:common.ratio_landscape" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:common.image_position",
      "options": [
        { "value": "left", "label": "t:common.align_left" },
        { "value": "right", "label": "t:common.align_right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "Unsere Idee"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Licht, das zu deinem Auto passt"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:common.text",
      "default": "<p>[PLATZHALTER] Erzähle hier die Geschichte hinter carbiente: Warum ihr Ambientebeleuchtung zum Selbsteinbau anbietet und was euch dabei wichtig ist.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:common.button_label",
      "default": "Mehr über uns"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:common.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.name"
    }
  ]
}
{% endschema %}
