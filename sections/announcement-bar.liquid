{% comment %}
  Announcement bar above the header. Without custom text it shows the free
  shipping message built from Theme settings → Shipping, so the threshold
  is maintained in exactly one place.
{% endcomment %}

{%- liquid
  assign text = section.settings.text
  if text == blank and settings.free_shipping_threshold > 0
    assign amount = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros
    assign text = 'announcement.free_shipping' | t: amount: amount
  endif
-%}

{%- if text != blank -%}
  <div class="announcement-bar color-{{ section.settings.color_scheme }}">
    <div class="page-width announcement-bar__inner">
      {%- if section.settings.link != blank -%}
        <a class="announcement-bar__text announcement-bar__link" href="{{ section.settings.link }}">
          {%- render 'icon', name: 'truck' -%}
          <span>{{ text }}</span>
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      {%- else -%}
        <p class="announcement-bar__text">
          {%- render 'icon', name: 'truck' -%}
          <span>{{ text }}</span>
        </p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar__inner {
    display: flex;
    justify-content: center;
  }

  .announcement-bar__text {
    --icon-size: 1.125rem;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding-block: var(--space-2);
    font-size: var(--fs-small);
    font-weight: var(--font-body-weight-bold);
    line-height: 1.3;
    text-align: center;
  }

  .announcement-bar__link {
    min-height: var(--touch-target);
    text-decoration: none;
  }

  @media (hover: hover) {
    .announcement-bar__link:hover span {
      text-decoration: underline;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "section-announcement-bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement_bar.text",
      "info": "t:sections.announcement_bar.text_info"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement_bar.link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name"
    }
  ]
}
{% endschema %}
