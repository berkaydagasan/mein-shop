          {
            "type": "color",
            "id": "success",
            "label": "t:settings.colors.success",
            "default": "#157347"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "accent",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text"
        }
      }
    ]
  },
  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings.typography.info"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:settings.typography.heading_font",
        "info": "t:settings.typography.heading_font_info",
        "default": "archivo_n6"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings.typography.body_font",
        "info": "t:settings.typography.body_font_info",
        "default": "inter_n4"
      },
      {
        "type": "select",
        "id": "type_heading_case",
        "label": "t:settings.typography.heading_case",
        "options": [
          {
            "value": "none",
            "label": "t:settings.typography.case_normal"
          },
          {
            "value": "uppercase",
            "label": "t:settings.typography.case_uppercase"
          }
        ],
        "default": "none"
      }
    ]
  },
  {
    "name": "t:settings.buttons.name",
    "settings": [
      {
        "type": "select",
        "id": "button_radius",
        "label": "t:settings.buttons.radius",
        "options": [
          {
            "value": "pill",
            "label": "t:settings.buttons.radius_pill"
          },
          {
            "value": "rounded",
            "label": "t:settings.buttons.radius_rounded"
          },
          {
            "value": "square",
            "label": "t:settings.buttons.radius_square"
          }
        ],
        "default": "pill"
      }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "select",
        "id": "page_width",
        "label": "t:settings.layout.page_width",
        "options": [
          {
            "value": "80rem",
            "label": "t:settings.layout.page_width_default"
          },
          {
            "value": "90rem",
            "label": "t:settings.layout.page_width_wide"
          }
        ],
        "default": "80rem"
      },
      {
        "type": "select",
        "id": "section_spacing",
        "label": "t:settings.layout.section_spacing",
        "options": [
          {
            "value": "normal",
            "label": "t:settings.layout.section_spacing_normal"
          },
          {
            "value": "compact",
            "label": "t:settings.layout.section_spacing_compact"
          }
        ],
        "default": "normal"
      },
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "t:settings.layout.animations",
        "info": "t:settings.layout.animations_info",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings.shipping.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings.shipping.info"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "t:settings.shipping.threshold",
        "info": "t:settings.shipping.threshold_info",
        "default": 50
      },
      {
        "type": "text",
        "id": "shipping_countries_note",
        "label": "t:settings.shipping.countries_note",
        "default": "Versand nach Deutschland, Österreich und in die Schweiz. [PLATZHALTER: Lieferzeiten folgen]"
      }
    ]
  }
]
