{% comment %}
  FAQ accordion built on <details>/<summary> – works without JavaScript,
  content stays in the HTML for search engines. Structured data (FAQPage)
  follows in step 11.
{% endcomment %}

{%- assign heading_id = 'Heading-' | append: section.id -%}

<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="faq" role="region" aria-labelledby="{{ heading_id }}">
      <div class="faq__intro">
        {% render 'section-heading',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          text: section.settings.text,
          id: heading_id
        %}
        {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
          <a class="button button--link" href="{{ section.settings.link_url }}">
            {{- section.settings.link_label -}}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="faq__list">
          {%- for block in section.blocks -%}
            <details class="faq__item" {{ block.shopify_attributes }}>
              <summary class="faq__question">
                <h3 class="faq__question-text">{{ block.settings.question }}</h3>
                {% render 'icon', name: 'plus', class: 'faq__icon' %}
              </summary>
              <div class="rte faq__answer">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .faq {
    display: grid;
    gap: var(--space-6);
  }

  .faq__intro .section-heading {
    margin-block-end: var(--space-3);
  }

  .faq__list {
    border-top: var(--border-width) solid var(--color-border);
  }

  .faq__item {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--touch-target);
    padding-block: var(--space-4);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question-text {
    font-family: var(--font-body-family);
    font-size: var(--fs-body);
    font-weight: var(--font-body-weight-bold);
    letter-spacing: 0;
    line-height: 1.4;
    text-transform: none;
  }

  .faq__icon {
    color: var(--color-accent);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__answer {
    padding-block-end: var(--space-5);
    color: var(--color-text-muted);
  }

  @media (min-width: 990px) {
    .faq {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.faq.name",
  "class": "section-faq",
  "max_blocks": 16,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Häufige Fragen zur Ambientebeleuchtung"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:common.text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:common.link_label",
      "default": "Alle Fragen ansehen"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:common.link_url"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.blocks.question.question",
          "default": "Frage"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.blocks.question.answer",
          "default": "<p>[PLATZHALTER] Antwort folgt.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
