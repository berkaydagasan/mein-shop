{% comment %}
  Site footer: brand column plus menu columns (blocks), legal links,
  cookie settings, dynamic payment icons, price note and copyright.

  Legal links come from a dedicated menu if set, otherwise automatically
  from the store's policies (Settings → Policies). Menu links to empty
  collections are hidden until products exist.
{% endcomment %}

<footer class="site-footer color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="site-footer__columns">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="site-footer__brand stack" style="--stack-space: var(--space-4);" {{ block.shopify_attributes }}>
              <a class="site-footer__logo" href="{{ routes.root_url }}">
                {%- render 'logo' -%}
                {%- if settings.logo != blank -%}
                  <span class="visually-hidden">{{ 'header.home' | t }}</span>
                {%- endif -%}
              </a>
              {%- if block.settings.text != blank -%}
                <div class="site-footer__text text-muted">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>

          {%- when 'menu' -%}
            {%- assign menu = block.settings.menu -%}
            {%- if menu.links.size > 0 -%}
              <nav class="site-footer__column" aria-labelledby="FooterHeading-{{ block.id }}" {{ block.shopify_attributes }}>
                <h2 id="FooterHeading-{{ block.id }}" class="site-footer__heading">
                  {{- block.settings.heading | default: menu.title -}}
                </h2>
                <ul class="site-footer__list" role="list">
                  {%- for link in menu.links -%}
                    {%- liquid
                      assign link_hidden = false
                      if link.type == 'collection_link' and link.object.all_products_count == 0
                        assign link_hidden = true
                      elsif link.type == 'catalog_link' and shop.products_count == 0
                        assign link_hidden = true
                      endif
                    -%}
                    {%- unless link_hidden -%}
                      <li>
                        <a
                          class="site-footer__link"
                          href="{{ link.url }}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- link.title -}}
                        </a>
                      </li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ul>
              </nav>
            {%- elsif request.design_mode -%}
              <p class="site-footer__hint text-small" {{ block.shopify_attributes }}>
                {{ 'footer.menu_hint' | t }}
              </p>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      {%- comment -%}
        Shopify's cookie banner adds a "Cookie settings" entry to shop.policies
        (#shopifyReshowConsentBanner). It is added manually only when it is
        not already part of the list.
      {%- endcomment -%}
      {%- liquid
        assign has_cookie_link = false
        assign has_imprint = false
        for policy in shop.policies
          if policy.url contains 'ReshowConsentBanner'
            assign has_cookie_link = true
          elsif policy.url contains 'legal-notice' or policy.url contains 'contact-information'
            assign has_imprint = true
          endif
        endfor

        assign missing_policies = ''
        unless has_imprint
          assign missing_policies = missing_policies | append: ', ' | append: 'footer.policy_imprint'
        endunless
        if shop.privacy_policy == blank
          assign missing_policies = missing_policies | append: ', ' | append: 'footer.policy_privacy'
        endif
        if shop.terms_of_service == blank
          assign missing_policies = missing_policies | append: ', ' | append: 'footer.policy_terms'
        endif
        if shop.refund_policy == blank
          assign missing_policies = missing_policies | append: ', ' | append: 'footer.policy_refund'
        endif
        if shop.shipping_policy == blank
          assign missing_policies = missing_policies | append: ', ' | append: 'footer.policy_shipping'
        endif
        assign missing_policies = missing_policies | remove_first: ', ' | split: ', '
      -%}
      <nav class="site-footer__legal" aria-label="{{ 'footer.legal' | t }}">
        <ul class="site-footer__legal-list" role="list">
          {%- if section.settings.legal_menu.links.size > 0 -%}
            {%- for link in section.settings.legal_menu.links -%}
              <li><a class="site-footer__link site-footer__link--small" href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- for policy in shop.policies -%}
              <li><a class="site-footer__link site-footer__link--small" href="{{ policy.url }}">{{ policy.title }}</a></li>
            {%- endfor -%}
          {%- endif -%}
          {%- if section.settings.legal_menu.links.size > 0 or has_cookie_link == false -%}
            <li>
              <a class="site-footer__link site-footer__link--small" href="#shopifyReshowConsentBanner">
                {{- 'footer.cookie_settings' | t -}}
              </a>
            </li>
          {%- endif -%}
        </ul>
        {%- if missing_policies.size > 0 -%}
          <p class="site-footer__placeholder text-small">
            {{ 'footer.legal_placeholder' | t }}
            {% for key in missing_policies %}{{ key | t }}{% unless forloop.last %}, {% endunless %}{% endfor %}
          </p>
        {%- endif -%}
      </nav>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="site-footer__payment">
          <h2 class="visually-hidden">{{ 'footer.payment_methods' | t }}</h2>
          <ul class="site-footer__payment-list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="site-footer__meta text-small text-muted">
        <p>
          {%- if shop.shipping_policy.url != blank -%}
            {%- capture shipping_link -%}
              <a href="{{ shop.shipping_policy.url }}">{{ 'footer.shipping_costs' | t }}</a>
            {%- endcapture -%}
            {{ 'footer.price_note_html' | t: link: shipping_link }}
          {%- else -%}
            {{ 'footer.price_note' | t }}
          {%- endif -%}
          {%- if settings.shipping_countries_note != blank %}
            {{ settings.shipping_countries_note }}
          {%- endif -%}
        </p>
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    padding-block: var(--space-8) var(--space-6);
    padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom));
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--space-5);
  }

  .site-footer__brand {
    grid-column: 1 / -1;
  }

  .site-footer__logo {
    display: inline-flex;
    min-height: var(--touch-target);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .site-footer__text {
    max-width: 30rem;
  }

  .site-footer__heading {
    margin-block-end: var(--space-2);
    font-family: var(--font-body-family);
    font-size: var(--fs-small);
    font-weight: var(--font-body-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    text-decoration: none;
  }

  .site-footer__link--small {
    font-size: var(--fs-small);
  }

  @media (hover: hover) {
    .site-footer__link:hover {
      text-decoration: underline;
    }
  }

  .site-footer__hint,
  .site-footer__placeholder {
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) dashed var(--color-border-strong);
    border-radius: var(--radius-s);
  }

  .site-footer__bottom {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }

  .site-footer__legal-list {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-5);
  }

  .site-footer__payment-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .site-footer__payment-icon {
    width: 3rem;
    height: auto;
  }

  .site-footer__meta {
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 750px) {
    .site-footer__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 990px) {
    .site-footer__columns {
      grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    }

    .site-footer__brand {
      grid-column: auto;
    }

    .site-footer__bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .site-footer__meta {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "t:sections.footer.legal_menu",
      "info": "t:sections.footer.legal_menu_info"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.brand.text",
          "default": "<p>Ambientebeleuchtung zum Selbsteinbau. [PLATZHALTER: Kurzbeschreibung der Marke]</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "limit": 4,
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.menu"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.heading",
          "info": "t:sections.footer.blocks.menu.heading_info"
        }
      ]
    }
  ]
}
{% endschema %}
