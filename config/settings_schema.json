          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings.colors.button_label",
            "default": "#FFFFFF"
          },
          {
            "type": "header",
            "content": "t:settings.colors.lines"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:settings.colors.border",
            "default": "#DDE2E8"
          },
          {
            "type": "color",
            "id": "border_strong",
            "label": "t:settings.colors.border_strong",
            "info": "t:settings.colors.border_strong_info",
            "default": "#8A94A3"
