{% doc %}
  Accessible pagination with real links (no JavaScript, no infinite
  scroll). Keeps filter and sort parameters because Shopify includes the
  current query in paginate URLs. Renders nothing for a single page.

  @param {paginate} paginate - The paginate object from {% paginate %}
  @param {string} [anchor] - Optional anchor appended to every URL, e.g. '#comments'

  @example
  {% render 'pagination', paginate: paginate %}
{% enddoc %}

{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'accessibility.pagination' | t }}">
    <ul class="pagination__list" role="list">
      {%- if paginate.previous -%}
        <li>
          <a class="pagination__item" href="{{ paginate.previous.url }}{{ anchor }}" rel="prev">
            {% render 'icon', name: 'chevron-left' %}
            <span class="visually-hidden">{{ 'pagination.previous' | t }}</span>
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__item" href="{{ part.url }}{{ anchor }}">
              <span class="visually-hidden">{{ 'pagination.page' | t }}</span>
              {{ part.title }}
            </a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__item pagination__item--current" aria-current="page">
              <span class="visually-hidden">{{ 'pagination.page' | t }}</span>
              {{ part.title }}
            </span>
          {%- else -%}
            <span class="pagination__item pagination__item--gap" aria-hidden="true">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a class="pagination__item" href="{{ paginate.next.url }}{{ anchor }}" rel="next">
            {% render 'icon', name: 'chevron-right' %}
            <span class="visually-hidden">{{ 'pagination.next' | t }}</span>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
