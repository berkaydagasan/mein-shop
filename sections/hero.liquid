{% comment %}
  Hero: the page's only H1, value proposition, up to two CTAs, background
  image (LCP: eager, fetchpriority="high", preloaded) with optional mobile
  image and optional muted video, plus an optional product highlight.

  The video never autoplays via HTML: a tiny script starts it only when the
  visitor has not requested reduced motion. The image stays the LCP element.
{% endcomment %}

{%- liquid
  assign image = section.settings.image | default: section.settings.image_mobile
  assign image_mobile = section.settings.image_mobile
  if section.settings.image == blank
    assign image_mobile = blank
  endif
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign highlight = section.settings.highlight_product
-%}

<div class="hero hero--{{ section.settings.height }} hero--{{ section.settings.content_position }} color-{{ section.settings.color_scheme }} glow">
  <div class="hero__media" aria-hidden="true">
    {%- if image != blank -%}
      {%- if image_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {%- for width in (1..4) -%}
                {%- assign w = width | times: 375 -%}
                {{ image_mobile | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}
              {%- endfor -%}
            "
            sizes="100vw"
            width="{{ image_mobile.width }}"
            height="{{ image_mobile.height }}"
          >
          {{
            image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1100, 1500, 1800, 2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: '',
              class: 'hero__image'
          }}
        </picture>
      {%- else -%}
        {{
          image
          | image_url: width: 2400
          | image_tag:
            widths: '375, 550, 750, 1100, 1500, 1800, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            preload: true,
            alt: '',
            class: 'hero__image'
        }}
      {%- endif -%}

      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', class: 'hero__video', image_size: '1920x'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'hero__placeholder' }}
      <span class="badge badge--muted hero__placeholder-label">{{ 'general.placeholder_image' | t }}</span>
    {%- endif -%}
    <div class="hero__overlay" style="--overlay: {{ overlay }};"></div>
  </div>

  <div class="hero__inner page-width">
    <div class="hero__content stack" style="--stack-space: var(--space-5);">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="h-display">{{ section.settings.heading | default: shop.name }}</h1>

      {%- if section.settings.text != blank -%}
        <div class="lead hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <div class="hero__buttons">
          <a class="button button--large" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          {%- if section.settings.button_secondary_label != blank and section.settings.button_secondary_link != blank -%}
            <a class="button button--large button--secondary" href="{{ section.settings.button_secondary_link }}">
              {{- section.settings.button_secondary_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if highlight != blank -%}
      <a class="hero__highlight" href="{{ highlight.url }}">
        {% render 'image',
          image: highlight.featured_image,
          alt: '',
          ratio: '1 / 1',
          fit: 'contain',
          sizes: '80px',
          max_width: 240,
          widths: '80, 160, 240',
          class: 'hero__highlight-image'
        %}
        <span class="hero__highlight-info">
          <span class="eyebrow hero__eyebrow">{{ 'sections.hero.highlight' | t }}</span>
          <span class="hero__highlight-title">{{ highlight.title }}</span>
          {% render 'price', product: highlight %}
        </span>
        {% render 'icon', name: 'arrow-right' %}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    isolation: isolate;
    overflow: hidden;
  }

  .hero--small {
    --hero-min: 28rem;
  }

  .hero--medium {
    --hero-min: 36rem;
  }

  .hero--large {
    --hero-min: 44rem;
  }

  .hero--screen {
    --hero-min: calc(100svh - var(--header-height));
  }

  .hero__media,
  .hero__inner {
    grid-area: 1 / 1;
  }

  .hero__media {
    position: relative;
    z-index: -1;
  }

  .hero__media picture,
  .hero__image,
  .hero__video,
  .hero__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__placeholder {
    fill: color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  .hero__placeholder-label {
    position: absolute;
    z-index: 1;
    inset-block-end: var(--space-4);
    inset-inline-end: var(--space-4);
  }

  .hero__video {
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  /* Overlay guarantees text contrast on any image: strongest at the bottom on mobile */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(11 15 20 / calc(var(--overlay) + 0.35)) 0%,
      rgb(11 15 20 / var(--overlay)) 55%,
      rgb(11 15 20 / calc(var(--overlay) * 0.6)) 100%
    );
  }

  .hero__inner {
    display: grid;
    align-content: end;
    gap: var(--space-7);
    min-height: min(var(--hero-min), 100svh - var(--header-height));
    padding-block: var(--space-9) var(--space-8);
  }

  .hero__content {
    max-width: 44rem;
  }

  .hero__eyebrow {
    color: var(--color-accent);
  }

  .hero__text {
    color: color-mix(in srgb, var(--color-text) 86%, transparent);
  }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .hero--center .hero__content {
    margin-inline: auto;
    text-align: center;
  }

  .hero--center .hero__buttons {
    justify-content: center;
  }

  .hero__highlight {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    align-items: center;
    gap: var(--space-4);
    max-width: 26rem;
    padding: var(--space-3);
    padding-inline-end: var(--space-5);
    border: var(--border-width) solid color-mix(in srgb, var(--color-text) 18%, transparent);
    border-radius: var(--radius-m);
    background-color: color-mix(in srgb, var(--color-bg) 72%, transparent);
    backdrop-filter: blur(12px);
    text-decoration: none;
  }

  .hero__highlight-info {
    display: grid;
    gap: var(--space-1);
  }

  .hero__highlight-title {
    font-weight: var(--font-body-weight-bold);
    line-height: 1.3;
  }

  @media (max-width: 749px) {
    .hero__buttons .button {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 750px) {
    .hero__overlay {
      background: linear-gradient(
        to right,
        rgb(11 15 20 / calc(var(--overlay) + 0.3)) 0%,
        rgb(11 15 20 / var(--overlay)) 50%,
        rgb(11 15 20 / calc(var(--overlay) * 0.4)) 100%
      );
    }

    .hero--center .hero__overlay {
      background: rgb(11 15 20 / calc(var(--overlay) + 0.1));
    }

    .hero__inner {
      align-content: center;
    }
  }

  @media (min-width: 990px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    /* Wide enough for "Ambientebeleuchtung" at display size without hyphenation */
    .hero__content {
      max-width: 58rem;
    }

    .hero--center .hero__inner {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Start hero videos only when the visitor does not prefer reduced motion
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('video.hero__video').forEach((video) => {
      video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
      video.play().catch(() => {});
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:common.media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:common.image",
      "info": "t:sections.hero.image_info"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:common.image_mobile",
      "info": "t:common.image_mobile_info"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.hero.video",
      "info": "t:sections.hero.video_info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:sections.hero.overlay",
      "info": "t:sections.hero.overlay_info",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:common.layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero.height",
      "options": [
        { "value": "small", "label": "t:sections.hero.height_small" },
        { "value": "medium", "label": "t:sections.hero.height_medium" },
        { "value": "large", "label": "t:sections.hero.height_large" },
        { "value": "screen", "label": "t:sections.hero.height_screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:common.alignment",
      "options": [
        { "value": "left", "label": "t:common.align_left" },
        { "value": "center", "label": "t:common.align_center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:common.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.heading",
      "info": "t:sections.hero.heading_info",
      "default": "Ambientebeleuchtung für dein Auto – zum Selbsteinbau"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:common.text",
      "default": "<p>LED-Lichtsets für den Innenraum – universell einsetzbar in Fahrzeugen mit passenden Schlitzen.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:common.button_label",
      "default": "Lichtsets entdecken"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:common.button_link"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "t:common.button_secondary_label",
      "default": "Einbau & Kompatibilität"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "t:common.button_secondary_link"
    },
    {
      "type": "header",
      "content": "t:sections.hero.highlight_header"
    },
    {
      "type": "product",
      "id": "highlight_product",
      "label": "t:sections.hero.highlight_product",
      "info": "t:sections.hero.highlight_product_info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
