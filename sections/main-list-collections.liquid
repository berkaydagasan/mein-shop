{% comment %}
  Interim collections overview (step 4).
{% endcomment %}

<div class="section page-width stack" style="--stack-space: var(--space-7);">
  <h1>{{ 'collections.title' | t }}</h1>

  <ul class="grid" role="list" style="--cols-mobile: 1; --cols-tablet: 2; --cols-desktop: 3;">
    {%- for collection in collections -%}
      <li class="collection-tile stack" style="--stack-space: var(--space-3);">
        {% render 'image',
          image: collection.featured_image,
          url: collection.url,
          alt: '',
          ratio: '4 / 5',
          sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
          max_width: 1000,
          widths: '300, 450, 600, 800, 1000',
          placeholder: 'collection-1'
        %}
        <h2 class="h3"><a class="link--plain" href="{{ collection.url }}">{{ collection.title }}</a></h2>
        {%- if collection.description != blank -%}
          <p class="text-muted">{{ collection.description | strip_html | truncatewords: 15 }}</p>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "settings": []
}
{% endschema %}
