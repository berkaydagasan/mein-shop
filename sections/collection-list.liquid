{% comment %}
  Collection teaser tiles. Tiles of empty or missing collections are hidden.
  Only when no tile has products, clearly marked placeholder tiles are
  shown (switchable) – so the section never mixes real and fake content.
{% endcomment %}

{%- liquid
  assign heading_id = 'Heading-' | append: section.id
  assign real_count = 0
  for block in section.blocks
    if block.settings.collection != blank and block.settings.collection.products_count > 0
      assign real_count = real_count | plus: 1
    endif
  endfor

  assign show_placeholders = false
  if real_count == 0 and section.settings.show_placeholders and section.blocks.size > 0
    assign show_placeholders = true
  endif

  if show_placeholders
    assign tile_count = section.blocks.size
  else
    assign tile_count = real_count
  endif
-%}

{%- if tile_count > 0 -%}
  <div class="section color-{{ section.settings.color_scheme }}">
    <div class="page-width" role="region" aria-labelledby="{{ heading_id }}">
      {% render 'section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        text: section.settings.text,
        id: heading_id
      %}

      <ul class="grid" role="list" style="--cols-mobile: 1; --cols-tablet: {{ tile_count | at_most: 2 }}; --cols-desktop: {{ tile_count | at_most: 3 }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign is_real = false
            if collection != blank and collection.products_count > 0
              assign is_real = true
            endif
            assign title = block.settings.title | default: collection.title
          -%}
          {%- if is_real or show_placeholders -%}
            <li class="collection-tile reveal" {{ block.shopify_attributes }}>
              {%- assign tile_image = block.settings.image | default: collection.featured_image -%}
              {% render 'image',
                image: tile_image,
                alt: '',
                ratio: '4 / 5',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                max_width: 1200,
                widths: '375, 550, 750, 1000, 1200',
                placeholder: 'collection-1',
                class: 'collection-tile__media'
              %}
              <div class="collection-tile__overlay color-scheme-3">
                {%- if is_real -%}
                  <h3 class="h3">
                    <a class="collection-tile__link" href="{{ collection.url }}">{{ title }}</a>
                  </h3>
                  <span class="collection-tile__cta" aria-hidden="true">
                    {{- 'collections.explore' | t -}}
                    {% render 'icon', name: 'arrow-right' %}
                  </span>
                {%- else -%}
                  <p class="badge badge--muted">{{ 'general.placeholder' | t }}</p>
                  {%- if title == blank -%}
                    {%- assign title = 'collections.placeholder_title' | t -%}
                  {%- endif -%}
                  <h3 class="h3">{{ title }}</h3>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width section">
    <p class="text-muted text-small">{{ 'sections.collection_list.empty_hint' | t }}</p>
  </div>
{%- endif -%}

{% stylesheet %}
  .collection-tile {
    position: relative;
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-m);
  }

  .collection-tile__media,
  .collection-tile__overlay {
    grid-area: 1 / 1;
  }

  .collection-tile__media > img {
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .collection-tile__overlay {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-6);
    background: linear-gradient(to top, rgb(11 15 20 / 0.82) 0%, rgb(11 15 20 / 0.2) 55%, transparent 100%);
  }

  .collection-tile__link {
    text-decoration: none;
  }

  /* The heading link covers the whole tile */
  .collection-tile__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .collection-tile__link:focus-visible {
    outline: none;
  }

  .collection-tile__link:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: -4px;
    border-radius: var(--radius-m);
  }

  .collection-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--font-body-weight-bold);
    color: var(--color-accent);
  }

  @media (hover: hover) {
    .collection-tile:hover .collection-tile__media > img {
      transform: scale(1.04);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "class": "section-collection-list",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "Kategorien"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Finde das passende Set"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:common.text"
    },
    {
      "type": "checkbox",
      "id": "show_placeholders",
      "label": "t:common.show_placeholders",
      "info": "t:sections.collection_list.show_placeholders_info",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:common.collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:common.title",
          "info": "t:sections.collection_list.blocks.collection.title_info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:common.image",
          "info": "t:sections.collection_list.blocks.collection.image_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
