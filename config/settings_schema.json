            "default": "#4D5866"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:settings.colors.accent",
            "info": "t:settings.colors.accent_info",
            "default": "#006F86"
          },
          {
            "type": "header",
            "content": "t:settings.colors.buttons"
