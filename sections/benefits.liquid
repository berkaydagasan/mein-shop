{% comment %}
  Product benefits: icon, title and short text per block.
  Default texts are placeholders – only publish claims that can be proven.
{% endcomment %}

{%- assign heading_id = 'Heading-' | append: section.id -%}

<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width" role="region" aria-labelledby="{{ heading_id }}">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      align: section.settings.heading_alignment,
      id: heading_id
    %}

    {%- if section.blocks.size > 0 -%}
      <ul class="grid benefits__list" role="list" style="--cols-mobile: 1; --cols-tablet: 2; --cols-desktop: {{ section.blocks.size | at_most: 4 }};">
        {%- for block in section.blocks -%}
          <li class="benefit reveal" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="benefit__icon">{% render 'icon', name: block.settings.icon %}</span>
            {%- endif -%}
            <h3 class="h4">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <div class="rte text-muted benefit__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .benefit {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
    border-radius: var(--radius-m);
    background-color: var(--color-surface);
  }

  .benefit__icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }

  .benefit__text {
    font-size: var(--fs-small);
    line-height: 1.55;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.benefits.name",
  "class": "section-benefits",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow",
      "default": "Vorteile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Warum carbiente?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:common.text"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:common.alignment",
      "options": [
        { "value": "left", "label": "t:common.align_left" },
        { "value": "center", "label": "t:common.align_center" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:sections.benefits.blocks.benefit.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:common.icon",
          "options": [
            { "value": "none", "label": "t:common.icons.none" },
            { "value": "truck", "label": "t:common.icons.truck" },
            { "value": "return", "label": "t:common.icons.return" },
            { "value": "lock", "label": "t:common.icons.lock" },
            { "value": "credit-card", "label": "t:common.icons.credit_card" },
            { "value": "shield-check", "label": "t:common.icons.shield_check" },
            { "value": "car", "label": "t:common.icons.car" },
            { "value": "ruler", "label": "t:common.icons.ruler" },
            { "value": "wrench", "label": "t:common.icons.wrench" },
            { "value": "lightbulb", "label": "t:common.icons.lightbulb" },
            { "value": "palette", "label": "t:common.icons.palette" },
            { "value": "plug", "label": "t:common.icons.plug" },
            { "value": "sparkle", "label": "t:common.icons.sparkle" },
            { "value": "mail", "label": "t:common.icons.mail" },
            { "value": "check", "label": "t:common.icons.check" },
            { "value": "info", "label": "t:common.icons.info" }
          ],
          "default": "sparkle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:common.title",
          "default": "Vorteil"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:common.text",
          "default": "<p>[PLATZHALTER] Beschreibe hier einen belegbaren Vorteil.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.benefits.name",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
