{% comment %}
  Social proof: real customer reviews and/or press logos only.
  Renders nothing without blocks. Shows a transparency note on how
  reviews are verified (§ 5b Abs. 3 UWG) whenever reviews are displayed.
  Never add invented reviews, ratings or customer numbers.
{% endcomment %}

{%- liquid
  assign heading_id = 'Heading-' | append: section.id
  assign review_count = 0
  assign logo_count = 0
  for block in section.blocks
    if block.type == 'review'
      assign review_count = review_count | plus: 1
    elsif block.type == 'logo'
      assign logo_count = logo_count | plus: 1
    endif
  endfor
-%}

{%- if section.blocks.size > 0 -%}
  <div class="section color-{{ section.settings.color_scheme }}">
    <div class="page-width" role="region" aria-labelledby="{{ heading_id }}">
      {% render 'section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        align: 'center',
        id: heading_id
      %}

      {%- if review_count > 0 -%}
        <ul class="grid social-proof__reviews" role="list" style="--cols-mobile: 1; --cols-tablet: 2; --cols-desktop: {{ review_count | at_most: 3 }};">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <li class="review reveal" {{ block.shopify_attributes }}>
                <figure class="stack" style="--stack-space: var(--space-4);">
                  <blockquote class="review__quote">{{ block.settings.quote }}</blockquote>
                  <figcaption class="review__author">
                    <strong>{{ block.settings.author }}</strong>
                    {%- if block.settings.detail != blank -%}
                      <span class="text-muted text-small">{{ block.settings.detail }}</span>
                    {%- endif -%}
                  </figcaption>
                </figure>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if logo_count > 0 -%}
        <ul class="social-proof__logos" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'logo' -%}
              <li {{ block.shopify_attributes }}>
                {%- capture logo_markup -%}
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 320 | image_tag: widths: '160, 320', sizes: '160px', alt: block.settings.name, class: 'social-proof__logo' }}
                  {%- else -%}
                    <span class="social-proof__logo-name">{{ block.settings.name }}</span>
                  {%- endif -%}
                {%- endcapture -%}
                {%- if block.settings.link != blank -%}
                  <a class="social-proof__logo-link" href="{{ block.settings.link }}">{{ logo_markup }}</a>
                {%- else -%}
                  {{ logo_markup }}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if review_count > 0 -%}
        {%- if section.settings.disclosure != blank -%}
          <div class="rte text-small text-muted social-proof__disclosure">{{ section.settings.disclosure }}</div>
        {%- elsif request.design_mode -%}
          <p class="text-small social-proof__disclosure">{{ 'sections.social_proof.disclosure_missing' | t }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width section">
    <p class="text-muted text-small">{{ 'sections.social_proof.empty_hint' | t }}</p>
  </div>
{%- endif -%}

{% stylesheet %}
  .review {
    padding: var(--space-6);
    border-radius: var(--radius-m);
    background-color: var(--color-surface);
  }

  .review__quote {
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .review__author {
    display: grid;
    gap: var(--space-1);
  }

  .social-proof__logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-5) var(--space-8);
    margin-block-start: var(--space-7);
  }

  .social-proof__logo {
    width: auto;
    max-width: 10rem;
    max-height: 3rem;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.8;
  }

  .social-proof__logo-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }

  .social-proof__logo-name {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }

  .social-proof__disclosure {
    max-width: var(--measure);
    margin: var(--space-7) auto 0;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.social_proof.name",
  "class": "section-social-proof",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.social_proof.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Das sagen unsere Kundinnen und Kunden"
    },
    {
      "type": "richtext",
      "id": "disclosure",
      "label": "t:sections.social_proof.disclosure",
      "info": "t:sections.social_proof.disclosure_info"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:sections.social_proof.blocks.review.name",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.social_proof.blocks.review.quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:sections.social_proof.blocks.review.author"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "t:sections.social_proof.blocks.review.detail",
          "info": "t:sections.social_proof.blocks.review.detail_info"
        }
      ]
    },
    {
      "type": "logo",
      "name": "t:sections.social_proof.blocks.logo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.social_proof.blocks.logo.image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.social_proof.blocks.logo.name_label",
          "info": "t:sections.social_proof.blocks.logo.name_info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.social_proof.blocks.logo.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.social_proof.name"
    }
  ]
}
{% endschema %}
