{% comment %}
  Final call to action: heading, short text and up to two buttons on a
  dark background with optional background image and accent glow.
{% endcomment %}

{%- assign heading_id = 'Heading-' | append: section.id -%}

<div class="cta-banner section color-{{ section.settings.color_scheme }}{% if section.settings.glow %} glow{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="cta-banner__media" aria-hidden="true">
      {% render 'image', image: section.settings.image, alt: '', sizes: '100vw', max_width: 2400 %}
      <div class="cta-banner__overlay"></div>
    </div>
  {%- endif -%}

  <div class="page-width page-width--narrow cta-banner__content text-center stack" style="--stack-space: var(--space-5);" role="region" aria-labelledby="{{ heading_id }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow cta-banner__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 id="{{ heading_id }}" class="h1">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="lead text-muted rte cta-banner__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="cta-banner__buttons">
        <a class="button button--large" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {%- if section.settings.button_secondary_label != blank and section.settings.button_secondary_link != blank -%}
          <a class="button button--large button--secondary" href="{{ section.settings.button_secondary_link }}">
            {{- section.settings.button_secondary_label -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .cta-banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .cta-banner__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta-banner__media .media {
    height: 100%;
    border-radius: 0;
  }

  .cta-banner__overlay {
    position: absolute;
    inset: 0;
    background-color: rgb(11 15 20 / 0.65);
  }

  .cta-banner__eyebrow {
    color: var(--color-accent);
  }

  .cta-banner__text {
    margin-inline: auto;
  }

  .cta-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  @media (max-width: 749px) {
    .cta-banner__buttons .button {
      flex: 1 1 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.cta_banner.name",
  "class": "section-cta-banner",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "glow",
      "label": "t:common.glow",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.cta_banner.image",
      "info": "t:sections.cta_banner.image_info"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:common.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading",
      "default": "Bereit für dein neues Lichtgefühl?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:common.text",
      "default": "<p>Entdecke unsere Ambiente-Lichtsets für den Selbsteinbau.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:common.button_label",
      "default": "Jetzt Lichtsets entdecken"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:common.button_link"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "t:common.button_secondary_label"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "t:common.button_secondary_link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.cta_banner.name"
    }
  ]
}
{% endschema %}
